/* Scheme 07 · Action board. One shared layout system for every page. */
page {
  background:#f4f1eb;color:#162438;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size:26rpx;line-height:1.5;
}
view,scroll-view,button,input,textarea,picker,navigator,image,text { box-sizing:border-box; }
.page button { width:auto;min-height:0;margin:0;padding:0;border:0;background:transparent;font:inherit;line-height:inherit;border-radius:0; }
button::after { border:0; }
button[disabled] { opacity:.5; }
input,textarea { font:inherit;color:#162438;border:0;background:transparent; }
input::placeholder,textarea::placeholder { color:#9aA3af; }
image { display:block; }
.page { min-height:100vh;padding:20rpx 22rpx calc(162rpx + env(safe-area-inset-bottom)); }
.page .board-section { margin-bottom:18rpx;padding:22rpx 20rpx 6rpx;border-radius:28rpx;background:#fff;box-shadow:0 4rpx 20rpx rgba(34,48,68,.025);overflow:hidden; }
.page .board-section.upcoming { background:linear-gradient(135deg,#eef6ff 0%,#fff 58%); }
.page .board-section.goods { background:linear-gradient(135deg,#fbf3e6 0%,#fff 60%); }
.page .board-section-head { min-height:48rpx;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding-bottom:15rpx; }
.page .section-heading { display:flex;align-items:center;gap:12rpx;min-width:0; }
.page .board-section-title { font-size:29rpx;font-weight:650;letter-spacing:-.5rpx;white-space:nowrap; }
.page .section-mark { position:relative;display:block;flex-shrink:0;width:30rpx;height:30rpx; }
.page .section-mark.bar { width:8rpx;height:30rpx;margin:0 11rpx 0 3rpx;border-radius:5rpx;background:#2d7dea; }
.page .section-mark.clock { border-radius:50%;background:#2d7dea; }
.page .section-mark.clock::before { content:"";position:absolute;left:14rpx;top:7rpx;width:2rpx;height:10rpx;border-radius:2rpx;background:#fff; }
.page .section-mark.clock::after { content:"";position:absolute;left:15rpx;top:15rpx;width:7rpx;height:2rpx;background:#fff;transform:rotate(30deg);transform-origin:left; }
.page .section-mark.leaf { width:27rpx;height:20rpx;margin-right:3rpx;border-radius:26rpx 3rpx;background:#a88053;transform:rotate(-25deg); }
.page .section-mark.leaf::after { content:"";position:absolute;left:4rpx;top:14rpx;width:23rpx;height:2rpx;background:#fff9;transform:rotate(-32deg); }
.page .section-more,.page .section-total { color:#8a94a3;font-size:21rpx;white-space:nowrap; }
.page .section-more { flex:0 0 auto;width:auto;padding:5rpx 0 5rpx 12rpx; }
.page .section-more text { margin-left:5rpx;font-size:28rpx;line-height:1; }
.page .board-list { width:100%; }
.page .board-task { display:flex;align-items:center;gap:15rpx;min-height:151rpx;padding:18rpx 0;border-top:1rpx solid #eef0f3; }
.page .board-task:first-child { border-top:0; }
.page .board-task:active { opacity:.65; }
.page .task-thumb { display:flex;flex:0 0 100rpx;width:100rpx;height:108rpx;align-items:center;justify-content:center;border-radius:16rpx;background:#eef4fb;overflow:hidden; }
.page .task-thumb.warm { background:#f4efe5; }
.page .thumb-photo { width:100%;height:100%; }
.page .thumb-icon { width:65rpx;height:65rpx; }
.page .task-main { flex:1;min-width:0; }
.page .task-tag-row { display:flex;align-items:center;gap:8rpx;min-width:0;margin-bottom:6rpx; }
.page .board-tag,.page .board-state { display:inline-block;flex:0 0 auto;max-width:150rpx;padding:2rpx 10rpx;border-radius:14rpx;font-size:18rpx;line-height:1.6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.page .board-tag { background:#287be4;color:#fff; }
.page .board-tag.warm { background:#a68158;color:#fff; }
.page .board-state.green { background:#e6f5ed;color:#388461; }
.page .board-state.blue { background:#e8f1ff;color:#3679ce; }
.page .board-state.warm { background:#f8edd9;color:#9a713d; }
.page .board-state.muted { background:#eff1f4;color:#828c99; }
.page .board-task-title { display:block;color:#142238;font-size:26rpx;font-weight:600;line-height:1.45;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.page .board-meta { display:flex;align-items:center;gap:11rpx;margin-top:7rpx;min-width:0;color:#8a95a5;font-size:20rpx;white-space:nowrap;overflow:hidden; }
.page .meta-time { flex-shrink:0;max-width:50%;overflow:hidden;text-overflow:ellipsis; }
.page .meta-time::before { content:"◷";margin-right:5rpx; }
.page .meta-place { min-width:0;overflow:hidden;text-overflow:ellipsis; }
.page .meta-place::before { content:"⌖";margin-right:4rpx; }
.page .task-side { display:flex;flex:0 0 auto;max-width:114rpx;flex-direction:column;align-items:flex-end;gap:8rpx;color:#8a95a5;font-size:19rpx; }
.page .row-price { max-width:110rpx;overflow:hidden;text-overflow:ellipsis;color:#846644;font-size:23rpx;font-weight:600;white-space:nowrap; }
.page .row-price.free { color:#3b8b6c; }
.page .row-count { white-space:nowrap;font-size:18rpx; }
.page .side-arrow { font-size:30rpx;line-height:1;color:#a2aaba; }
.page .service-rail { display:flex;justify-content:space-between;padding:18rpx 7rpx 8rpx;background:#fff;border-radius:26rpx; }
.page .rail-item { display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;color:#4d5a6d; }
.page .rail-icon { width:62rpx;height:62rpx;padding:12rpx;margin-bottom:8rpx;border-radius:50%;background:#edf4ff; }
.page .rail-icon image { width:100%;height:100%; }
.page .rail-name { font-size:20rpx;white-space:nowrap;line-height:1.4; }
.page .rail-indicator { height:5rpx;width:28rpx;margin-top:9rpx;border-radius:5rpx; }
.page .rail-item.active { color:#1d70db;font-weight:600; }
.page .rail-item.active .rail-indicator { background:#277de9; }
.page .rail-item.active .rail-icon { background:#dceaff; }
.page .feed-tools { display:flex;align-items:center;justify-content:space-between;height:65rpx;padding:0 6rpx;color:#9bA2ac;font-size:20rpx; }
.page .search-shortcut { display:flex;align-items:center;gap:8rpx;color:#7d8999;font-size:21rpx; }
.page .magnifier { position:relative;display:inline-block;flex-shrink:0;width:24rpx;height:24rpx;border:2.5rpx solid currentColor;border-radius:50%;margin-right:5rpx; }
.page .magnifier::after { content:"";position:absolute;right:-7rpx;bottom:-5rpx;width:11rpx;height:2.5rpx;background:currentColor;transform:rotate(45deg); }
.page .sub-scroll { display:block;width:100%;white-space:nowrap;margin:0 0 18rpx;overflow-x:auto; }
.page .sub-scroll::-webkit-scrollbar { display:none;width:0;height:0; }
.page .sub-pill { display:inline-flex;align-items:center;justify-content:center;min-height:57rpx;padding:8rpx 22rpx;margin-right:10rpx;border-radius:28rpx;background:#fff;color:#758195;font-size:22rpx; }
.page .sub-pill.active { background:#287be4;color:#fff; }
.page .nav { position:fixed;z-index:40;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-around;height:calc(112rpx + env(safe-area-inset-bottom));padding:5rpx 54rpx calc(5rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e9edf1;border-radius:28rpx 28rpx 0 0;background:rgba(255,255,255,.96);box-shadow:0 -6rpx 25rpx rgba(37,52,75,.035); }
.page .nav-item,.page .nav-publish { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;min-width:86rpx;color:#8e98a7;font-size:20rpx; }
.page .nav-item.active,.page .nav-publish.active { color:#2478de; }
.page .nav-icon { position:relative;display:block;width:41rpx;height:41rpx;margin:0 0 3rpx; }
.page .nav-home::before { content:"";position:absolute;left:8rpx;top:9rpx;width:25rpx;height:25rpx;background:currentColor;border-radius:5rpx;transform:rotate(45deg); }
.page .nav-home::after { content:"";position:absolute;left:9rpx;bottom:0;width:24rpx;height:24rpx;border-radius:2rpx;background:currentColor; }
.page .nav-profile::before { content:"";position:absolute;left:13rpx;top:0;width:16rpx;height:16rpx;border:3rpx solid currentColor;border-radius:50%; }
.page .nav-profile::after { content:"";position:absolute;left:6rpx;bottom:0;width:30rpx;height:18rpx;border:3rpx solid currentColor;border-radius:20rpx 20rpx 4rpx 4rpx; }
.page .nav-publish { margin-top:-27rpx;gap:4rpx; }
.page .nav-add { display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border:7rpx solid #fff;border-radius:50%;background:#287be4;color:#fff;font-size:49rpx;font-weight:300;line-height:1;box-shadow:0 3rpx 18rpx #287be430; }
.page .empty-panel { display:flex;flex-direction:column;align-items:center;gap:20rpx;padding:75rpx 24rpx;border-radius:28rpx;background:#fff;text-align:center; }
.page .empty-title { font-size:27rpx;color:#68788d; }
.page .empty-symbol { display:flex;align-items:center;justify-content:center;width:85rpx;height:85rpx;margin-bottom:4rpx;border-radius:50%;background:#edf4ff;color:#4488df;font-size:48rpx; }
.page .section-empty { display:block;padding:50rpx 12rpx;color:#9aa4b2;text-align:center;font-size:24rpx; }
.page .text-link { color:#2877d8;font-size:24rpx; }
.page .inline-error { margin-bottom:18rpx;padding:20rpx;border-radius:16rpx;background:#eef4fc;color:#58769c;font-size:23rpx;text-align:center; }
.page .skeleton-heading { width:180rpx;height:27rpx;border-radius:8rpx;background:#eef1f6;margin:4rpx 0 20rpx; }
.page .skeleton-row { height:130rpx;margin-bottom:14rpx;border-radius:16rpx;background:linear-gradient(100deg,#f3f5f8,#fafbfc,#f3f5f8); }
.page .search-head { display:flex;gap:17rpx;align-items:center;margin-bottom:20rpx; }
.page .search-entry { display:flex;align-items:center;gap:15rpx;flex:1;min-width:0;height:80rpx;padding:0 25rpx;border-radius:22rpx;background:#fff;color:#8f9bad; }
.page .search-entry input { flex:1;min-width:0;height:78rpx;font-size:25rpx; }
.page .search-clear { display:flex;align-items:center;justify-content:center;width:32rpx;height:40rpx;color:#9ba5b3;font-size:32rpx; }
.page .search-submit { flex:0 0 auto;color:#2877d8;font-size:27rpx; }
.page .history-list { display:flex;flex-wrap:wrap;gap:13rpx;padding:5rpx 0 22rpx; }
.page .history-item { padding:10rpx 22rpx;max-width:100%;border-radius:20rpx;background:#f3f5f8;color:#69778b;font-size:23rpx; }
.page .history-list .section-empty { width:100%; }
.page .identity-card { display:flex;align-items:center;gap:21rpx;padding:30rpx 25rpx;margin-bottom:19rpx;border-radius:28rpx;background:#fff; }
.page .avatar { flex:0 0 102rpx;width:102rpx;height:102rpx;border-radius:50%;overflow:hidden;background:#edf4ff; }
.page .avatar image { width:100%;height:100%; }
.page .identity-main { flex:1;min-width:0; }
.page .notice-list { margin:0 0 18rpx; }
.page .notice-item { display:flex;align-items:center;gap:18rpx;padding:20rpx 24rpx;background:#fff7ed;border:1rpx solid #ffe2c0;border-radius:18rpx;margin-bottom:12rpx; }
.page .notice-item.read { opacity:.62;background:#f7f8fa;border-color:#e7ebf0; }
.page .notice-copy { flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx; }
.page .notice-title { color:#8d4d23;font-size:25rpx;font-weight:600; }
.page .notice-message { color:#6d7887;font-size:22rpx;line-height:1.45; }
.page .notice-arrow { color:#b9c1cd;font-size:34rpx; }
.page .profile-name { display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:33rpx;font-weight:650; }
.page .profile-meta { display:block;margin-top:9rpx;color:#8e9aab;font-size:22rpx; }
.page .edit-profile { color:#8a99ac;font-size:23rpx; }
.page .edit-profile text { margin-left:6rpx;font-size:28rpx; }
.page .stats { display:flex;background:#fff;margin-bottom:19rpx;padding:4rpx 13rpx;border-radius:26rpx; }
.page .stat { position:relative;flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:120rpx;color:#93a0b2; }
.page .stat-num { font-size:35rpx;font-weight:600;color:#718199;line-height:1.3; }
.page .stat-label { margin-top:5rpx;font-size:23rpx; }
.page .stat.active,.page .stat.active .stat-num { color:#287be4; }
.page .stat.active::after { content:"";position:absolute;bottom:0;left:35%;right:35%;height:5rpx;border-radius:5rpx;background:#287be4; }
.page .form-panel { padding:24rpx 26rpx 5rpx; }
.page .form-panel .board-section-head { margin-bottom:10rpx; }
.page .form-item { min-width:0;margin-bottom:25rpx; }
.page .label { display:block;margin-bottom:12rpx;color:#526078;font-size:24rpx;font-weight:500; }
.page .optional { color:#9ca6b4;font-size:21rpx;font-weight:400;margin-left:6rpx; }
.page .field,.page .picker-field { display:block;width:100%;min-height:82rpx;padding:0 23rpx;border:1rpx solid #e7ecf2;border-radius:18rpx;background:#f8f9fb;font-size:26rpx; }
.page .field:focus { border-color:#a7c8f4;background:#fff; }
.page .picker-field { display:flex;align-items:center;justify-content:space-between;gap:10rpx; }
.page .picker-field.placeholder { color:#9ca6b4; }
.page .picker-arrow { color:#9faab8;font-size:28rpx; }
.page .textarea { height:170rpx;padding:21rpx 23rpx;line-height:1.6; }
.page .row { display:flex;gap:18rpx; }
.page .row>.form-item { flex:1;min-width:0; }
.page .primary,.page .secondary { display:flex;width:100%;min-height:86rpx;align-items:center;justify-content:center;border-radius:21rpx;font-size:28rpx;font-weight:600; }
.page .primary { background:#287be4;color:#fff;box-shadow:0 7rpx 22rpx #287be41c; }
.page .secondary { background:#eaf2fe;color:#2877d5;border:1rpx solid #dce9fb; }
.page .error { display:block;padding:0 4rpx 20rpx;color:#bb5353;font-size:23rpx; }
.page .privacy-note { display:block;margin:-5rpx 0 25rpx;color:#99a4b3;font-size:22rpx; }
.page .category-panel { padding-bottom:20rpx; }
.page .publish-categories { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13rpx;padding-top:4rpx; }
.page .publish-category { position:relative;display:flex;align-items:center;gap:10rpx;min-height:95rpx;padding:14rpx 10rpx;border:1rpx solid #edf0f5;border-radius:19rpx;background:#f9fafc;color:#64738a;font-size:23rpx;white-space:nowrap; }
.page .publish-category image { width:38rpx;height:38rpx;flex-shrink:0; }
.page .publish-category.active { border-color:#85b7f4;background:#eef5ff;color:#2474d8; }
.page .select-prompt { padding:25rpx;text-align:center;font-size:24rpx;color:#9ca5b0; }
.page .radio-row { display:flex;gap:12rpx;padding:6rpx;border-radius:18rpx;background:#f1f4f8; }
.page .radio { flex:1;padding:14rpx 5rpx;border-radius:14rpx;color:#8d99a9;font-size:24rpx; }
.page .radio.active { background:#fff;color:#287be4;box-shadow:0 2rpx 9rpx #2339550c; }
.page .price-input { display:flex;align-items:center;gap:16rpx;height:82rpx;padding:0 24rpx;border:1rpx solid #e7ecf2;border-radius:18rpx;background:#f8f9fb; }
.page .price-input>text { color:#8d7556;font-size:31rpx; }
.page .price-input input { flex:1;height:80rpx;min-width:0;font-size:26rpx; }
.page .image-grid { display:flex;flex-wrap:wrap;gap:13rpx; }
.page .image-preview,.page .image-add { position:relative;width:138rpx;height:138rpx;border-radius:17rpx;background:#f3f6fa;overflow:hidden; }
.page .image-preview image { width:100%;height:100%; }
.page .image-remove { position:absolute;top:5rpx;right:5rpx;display:flex;align-items:center;justify-content:center;width:35rpx;height:35rpx;border-radius:50%;background:#1c2d497d;color:#fff;font-size:27rpx; }
.page .image-add { display:flex;flex-direction:column;align-items:center;justify-content:center;color:#94a4b8;font-size:21rpx;border:1rpx dashed #cbd8e8; }
.page .image-add text:first-child { font-size:40rpx;line-height:1.3; }
.page .qr-upload { position:relative;display:flex;align-items:center;min-height:150rpx; }
.page .qr-preview { width:220rpx;height:220rpx;border-radius:17rpx;background:#f3f6fa; }
.page .qr-add { width:220rpx;height:220rpx; }
.page .contact-qr { display:block;width:260rpx;height:260rpx;margin:20rpx auto 4rpx;border-radius:16rpx;background:#f3f6fa; }
.page .summary-top,.page .category-heading { display:flex;align-items:center;gap:13rpx; }
.page .summary-top { justify-content:space-between; }
.page .detail-summary { padding:24rpx 25rpx; }
.page .summary-icon { display:flex;align-items:center;justify-content:center;width:65rpx;height:65rpx;background:#edf4ff;border-radius:19rpx; }
.page .summary-icon image { width:40rpx;height:40rpx; }
.page .detail-title { display:block;margin:22rpx 0;color:#17283d;font-size:37rpx;font-weight:650;line-height:1.55; }
.page .summary-bottom { display:flex;align-items:center;gap:14rpx;color:#9aa5b4;font-size:22rpx; }
.page .detail-price { color:#8b6943;font-size:35rpx;font-weight:600; }
.page .summary-owner { flex:1; }
.page .summary-count { color:#6486b3; }
.page .progress-track { display:flex;align-items:flex-start;padding:18rpx 10rpx 30rpx; }
.page .progress-node { display:flex;flex-direction:column;align-items:center;gap:12rpx;color:#a2adbb;font-size:21rpx; }
.page .progress-dot { display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border-radius:50%;background:#edf0f5;font-size:19rpx; }
.page .progress-node.reached { color:#3c7ed2; }
.page .progress-node.reached .progress-dot { background:#287be4;color:#fff; }
.page .progress-line { flex:1;height:2rpx;margin:18rpx 12rpx 0;background:#e9edf3; }
.page .progress-line.reached { background:#a9caef; }
.page .info-line { display:flex;align-items:flex-start;justify-content:space-between;gap:25rpx;padding:22rpx 1rpx;border-top:1rpx solid #eef0f4;font-size:25rpx; }
.page .info-line>text:first-child { flex:0 0 140rpx;color:#97a2b2; }
.page .info-line>text:last-child { text-align:right;color:#536178;word-break:break-all; }
.page .detail-body { display:block;padding:5rpx 1rpx 25rpx;color:#64738a;font-size:26rpx;line-height:1.85;white-space:pre-wrap; }
.page .detail-images { display:flex;flex-wrap:wrap;gap:13rpx;padding-bottom:22rpx; }
.page .detail-images image { width:calc((100% - 26rpx)/3);height:186rpx;border-radius:15rpx;background:#f3f6fa; }
.page .contact-value { display:block;padding:3rpx 0 22rpx;color:#55769f;font-size:25rpx;word-break:break-all; }
.page .contact-panel { background:#f6faff; }
.page .detail-actions { margin-top:23rpx; }
.page .owner-buttons { display:flex;gap:16rpx; }
.page .owner-buttons button { flex:1;min-width:0; }
.page .danger-link { display:block;width:100%;padding:24rpx 10rpx 5rpx;text-align:center;color:#b16868;font-size:23rpx; }
