<view class="page profile-page">
  <view class="profile-head"><button class="avatar" bindtap="chooseAvatar" aria-label="更换头像"><image src="{{avatar}}" mode="aspectFill"/></button><view class="profile-copy"><text class="profile-name">{{profile.name || '新同学'}}</text><text class="profile-meta"><text>{{profile.building || '未完善楼栋'}}</text><text wx:if="{{profile.room}}"> {{profile.room}}室</text></text></view></view>
  <view class="stats"><button class="stat {{activeTab === 'seeking' ? 'active' : ''}}" data-tab="seeking" bindtap="tabChange"><text class="stat-num">{{stats.seeking || 0}}</text><text class="stat-label">求助</text></button><button class="stat {{activeTab === 'joined' ? 'active' : ''}}" data-tab="joined" bindtap="tabChange"><text class="stat-num">{{stats.joined || 0}}</text><text class="stat-label">已接单</text></button><button class="stat {{activeTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="tabChange"><text class="stat-num">{{stats.completed || 0}}</text><text class="stat-label">已完成</text></button></view>
  <view class="profile-list"><view class="task-list"><block wx:for="{{list}}" wx:key="id"><navigator class="task" url="/pages/detail/detail?id={{item.id}}"><view class="task-top"><text class="badge {{item.intent === 'offer' ? 'offer' : ''}}">{{item.intent === 'offer' ? '可提供' : '求帮助'}}</text><text class="task-category">{{item.category}}</text><text class="status {{item.status}}">{{item.status === 'completed' || (item.category === '免费送' && item.availableQuantity === 0) ? '已完成' : (item.status === 'cancelled' ? '已删除' : (item.claimed ? '进行中' : '待响应'))}}</text></view><text class="task-title">{{item.title || item.subcategory}}</text><text class="route">⌖ {{item.place || '校内交接'}}</text></navigator></block><view class="empty" wx:if="{{!loading && !list.length}}">这里还没有单</view><view class="empty" wx:if="{{loading}}">正在加载…</view></view></view>
  <view class="nav"><navigator class="nav-item" url="/pages/index/index" open-type="reLaunch"><text class="nav-icon nav-home"></text><text>首页</text></navigator><navigator class="nav-add" url="/pages/publish/publish">＋</navigator><navigator class="nav-item active" url="/pages/profile/profile"><text class="nav-icon nav-profile"></text><text>我的</text></navigator></view>
</view>
