<import src="../../templates/board.wxml"/>
<view class="page profile-page">
  <view class="identity-card">
    <button class="avatar" bindtap="openAvatar" aria-label="查看头像"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"/><view wx:else class="avatar-placeholder">头像</view></button>
    <view class="identity-main" bindtap="editProfile" aria-role="button" aria-label="编辑资料"><text class="profile-name">{{profile.name || '新同学'}}</text><text class="profile-meta">{{profile.building || '未填写宿舍'}}<text wx:if="{{profile.room}}"> · {{profile.room}}室</text></text></view>
    <button class="edit-profile" bindtap="editProfile">编辑 <text>›</text></button>
  </view>
  <view class="notice-list" wx:if="{{notifications.length}}">
    <view class="notice-item {{item.readAt ? 'read' : ''}}" wx:for="{{notifications}}" wx:key="id" data-id="{{item.id}}" bindtap="readNotification"><view class="notice-copy"><text class="notice-title">{{item.title}}</text><text class="notice-message">{{item.message}}</text></view><text class="notice-arrow">›</text></view>
  </view>
  <view class="stats">
    <button class="stat {{activeTab === 'published' ? 'active' : ''}}" data-tab="published" bindtap="tabChange"><text class="stat-num">{{stats.published}}</text><text class="stat-label">我发布的</text></button>
    <button class="stat {{activeTab === 'joined' ? 'active' : ''}}" data-tab="joined" bindtap="tabChange"><text class="stat-num">{{stats.joined}}</text><text class="stat-label">我参与的</text></button>
    <button class="stat {{activeTab === 'completed' ? 'active' : ''}}" data-tab="completed" bindtap="tabChange"><text class="stat-num">{{stats.completed}}</text><text class="stat-label">已完成</text></button>
  </view>
  <view class="board-section">
    <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">{{listTitle}}</text></view><text class="section-total">{{list.length}} 条</text></view>
    <view class="inline-error" wx:if="{{error}}" bindtap="retry">{{error}} ↻</view>
    <view class="board-list"><block wx:for="{{list}}" wx:key="id"><template is="post-row" data="{{post: item}}"/></block></view>
    <view class="section-empty" wx:if="{{loading}}">正在加载…</view>
    <view class="section-empty" wx:if="{{!loading && !error && !list.length}}">{{activeTab === 'completed' ? '完成的互助会出现在这里' : '暂时没有相关记录'}}</view>
  </view>
  <template is="bottom-nav" data="{{active: 'profile'}}"/>
</view>
