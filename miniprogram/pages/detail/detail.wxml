<view class="page"><view class="head-row"><button class="back" bindtap="back">‹</button></view><view class="card" wx:if="{{post}}"><text class="detail-kicker">任务详情</text><view class="task-top"><text class="badge {{post.intent === 'offer' ? 'offer' : ''}}">{{post.intent === 'offer' ? '可提供' : '求帮助'}}</text><text class="status {{post.status}}">{{post.status === 'completed' ? '已完成' : (post.status === 'cancelled' ? '已删除' : (post.claimed ? '进行中' : '待响应'))}}</text><text class="price" wx:if="{{priceText}}">{{priceText}}</text></view><text class="detail-title">{{post.title || post.subcategory || post.category}}</text><text class="detail-label">单内容</text><view class="detail-body">{{post.detail || '暂无补充说明'}}</view><view class="info-line"><text>类型</text><text>{{post.category}} · {{post.subcategory}}</text></view><view class="info-line"><text>地点</text><text>{{post.place || '校内交接'}}</text></view><view class="info-line"><text>时间</text><text>{{post.time || '时间待定'}}</text></view><view class="info-line"><text>单主</text><text>{{post.ownerName || '校园同学'}}</text></view><view class="contact-box" wx:if="{{post.isOwner || post.claimedByMe}}"><text class="label">联系方式</text><text>{{post.contact || '发布者暂未填写'}}</text></view><button wx:if="{{!post.isOwner && post.status === 'active'}}" class="primary detail-action {{post.actionDisabled ? 'disabled' : ''}}" disabled="{{post.actionDisabled || operating}}" loading="{{operating}}" bindtap="claim">{{post.actionDisabled ? post.actionButtonLabel : action}}</button><view wx:if="{{post.isOwner && post.status === 'active'}}" class="owner-actions"><button class="primary" loading="{{operating}}" disabled="{{operating}}" bindtap="complete">标记完成</button><button class="danger-link" disabled="{{operating}}" bindtap="remove">删除这个单</button></view></view><view class="empty" wx:else>{{loading ? '正在加载…' : '这个单不存在'}}</view><view class="nav"><navigator class="nav-item" url="/pages/index/index" open-type="reLaunch"><text class="nav-icon nav-home"></text><text>首页</text></navigator><navigator class="nav-add" url="/pages/publish/publish">＋</navigator><navigator class="nav-item" url="/pages/profile/profile"><text class="nav-icon nav-profile"></text><text>我的</text></navigator></view></view>
