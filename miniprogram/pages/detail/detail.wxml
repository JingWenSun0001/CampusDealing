<import src="../../templates/board.wxml"/>
<view class="page detail-page">
  <block wx:if="{{post}}">
    <view class="board-section detail-summary" bindlongpress="report">
      <view class="summary-top"><view class="category-heading"><view class="summary-icon"><view wx:if="{{post.categoryKey === 'service'}}" class="sparkles-icon summary-sparkles"><text class="sparkle sparkle-large">✦</text><text class="sparkle sparkle-small">✦</text></view><image wx:else src="{{post.categoryIcon}}" mode="aspectFit"/></view><text class="board-tag {{post.isGoods ? 'warm' : ''}}">{{post.category}}</text></view><text class="board-state {{post.stateTone}}">{{post.stateLabel}}</text></view>
      <text class="detail-title">{{post.title || post.subcategory}}</text>
      <view class="summary-bottom"><text class="detail-price" wx:if="{{post.priceLabel}}">{{post.priceLabel}}</text><text class="summary-owner">{{post.ownerName || '校园同学'}} 发布</text><text class="summary-count" wx:if="{{post.countText}}">{{post.countText}}</text></view>
    </view>
    <view class="board-section" wx:if="{{!editing}}">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark clock"></text><text class="board-section-title">{{post.isCarpool ? '行程信息' : '发布信息'}}</text></view></view>
      <view class="info-line" wx:if="{{post.isCarpool}}"><text>目的地</text><text>{{post.displaySubcategory || post.subcategory}}</text></view>
      <view class="info-line" wx:if="{{post.isCarpool}}"><text>集合地点</text><text>{{post.placeLabel}}</text></view>
      <view class="info-line" wx:if="{{post.isCarpool}}"><text>出发时间</text><text>{{post.time}}</text></view>
      <view class="info-line" wx:if="{{post.isCarpool}}"><text>搭子性别</text><text>{{post.extra.gender || '不限性别'}}</text></view>
      <view class="info-line" wx:if="{{post.isRental}}"><text>物品类别</text><text>{{post.displaySubcategory || post.subcategory}}</text></view>
      <view class="info-line" wx:if="{{post.category === '服务'}}"><text>服务类型</text><text>{{post.displaySubcategory || post.subcategory}}</text></view>
      <view class="info-line" wx:if="{{post.category === '代购'}}"><text>购买地点</text><text>{{post.displaySubcategory || post.subcategory}}</text></view>
      <view class="info-line" wx:if="{{post.category === '二手好物'}}"><text>物品分类</text><text>{{post.displaySubcategory || post.subcategory}}</text></view>
      <view class="info-line" wx:if="{{post.isFreeGive}}"><text>剩余数量</text><text>{{post.availableQuantity}} / {{post.quantity}} 份</text></view>
    </view>
    <view class="board-section form-panel" wx:if="{{editing}}">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark clock"></text><text class="board-section-title">修改行程</text></view></view>
      <view class="form-item"><text class="label">目的地</text><floating-select id="edit-subcategory" data-select="subcategory" label="目的地" options="{{destinationOptions}}" value="{{editForm.subcategory}}" placeholder="请选择" other-hint="默认从学校出发" bind:open="closeEditSelects" bind:change="editSelectChange"/></view>
      <view class="form-item" wx:if="{{editForm.subcategory === '其他'}}"><text class="label">具体目的地</text><input class="field" maxlength="60" value="{{editForm.destination}}" data-key="destination" bindinput="editInput"/></view>
      <view class="form-item"><text class="label">集合地点</text><floating-select id="edit-place" data-select="place" label="集合地点" options="{{placeOptions}}" value="{{editForm.place}}" placeholder="请选择" bind:open="closeEditSelects" bind:change="editSelectChange"/></view>
      <view class="row"><view class="form-item"><text class="label">出发日期</text><floating-select id="edit-date" data-select="date" label="出发日期" mode="date" value="{{editForm.date}}" start="{{dateStart}}" placeholder="选择日期" bind:open="closeEditSelects" bind:change="editSelectChange"/></view><view class="form-item"><text class="label">出发时间</text><floating-select id="edit-time" data-select="time" label="出发时间" mode="time" value="{{editForm.time}}" start="05:00" end="23:55" minute-step="{{5}}" placeholder="选择时间" bind:open="closeEditSelects" bind:change="editSelectChange"/></view></view>
      <view class="form-item"><text class="label">搭子性别</text><floating-select id="edit-gender" data-select="gender" label="搭子性别" options="{{genderOptions}}" value="{{editForm.gender}}" bind:open="closeEditSelects" bind:change="editSelectChange"/></view>
      <text class="error" wx:if="{{error}}">{{error}}</text>
      <view class="owner-buttons"><button class="secondary" disabled="{{operating}}" bindtap="cancelEdit">取消</button><button class="primary" loading="{{operating}}" disabled="{{operating}}" bindtap="saveEdit">保存修改</button></view>
    </view>
    <view class="board-section" wx:if="{{post.detail || post.images.length}}">
      <view class="board-section-head" wx:if="{{post.detail}}"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">{{post.category === '服务' ? '服务能力与经历' : '说明'}}</text></view></view>
      <text class="detail-body" wx:if="{{post.detail}}">{{post.detail}}</text>
      <view class="detail-images" wx:if="{{post.images.length}}"><block wx:for="{{post.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"/></block></view>
    </view>
    <view class="board-section contact-panel" wx:if="{{!post.isCarpool && (post.isOwner || post.claimedByMe) && post.contactQr}}">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">联系发布者</text></view><button wx:if="{{post.contactQr}}" class="text-link" bindtap="previewQr">查看</button></view>
      <text class="contact-value">微信好友码 · 仅匹配双方可见</text>
      <image class="contact-qr" src="{{post.contactQr}}" mode="aspectFit" bindtap="previewQr"/>
    </view>
    <view class="board-section contact-panel" wx:if="{{post.isCarpool && (post.isOwner || post.claimedByMe) && post.contactQr}}">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">行程联系入口</text></view><button class="text-link" bindtap="previewQr">查看</button></view>
      <text class="contact-value">微信好友码 · 仅匹配双方可见</text>
      <image class="contact-qr" src="{{post.contactQr}}" mode="aspectFit" bindtap="previewQr"/>
    </view>
    <view class="detail-actions" wx:if="{{!editing}}">
      <button wx:if="{{!post.isOwner && !post.claimedByMe && post.status === 'active'}}" class="primary" disabled="{{post.actionDisabled || operating}}" loading="{{operating}}" bindtap="claim">{{post.actionButtonLabel}}</button>
      <button wx:if="{{post.claimedByMe && post.status !== 'completed' && post.status !== 'cancelled'}}" class="secondary" disabled="{{operating}}" bindtap="cancelClaim">取消参与</button>
      <block wx:if="{{post.isOwner && (post.status === 'active' || post.status === 'matched')}}">
        <view class="owner-buttons"><button wx:if="{{!post.isCarpool && post.claimed}}" class="secondary" disabled="{{operating}}" bindtap="reopen">重新开放</button><button wx:if="{{post.isCarpool}}" class="secondary" disabled="{{operating}}" bindtap="close">手动结单</button><button wx:if="{{post.isCarpool}}" class="secondary" disabled="{{operating}}" bindtap="edit">修改行程</button><button wx:if="{{!post.isCarpool}}" class="primary" loading="{{operating}}" disabled="{{operating}}" bindtap="complete">结束本次互助</button></view>
      </block>
      <button wx:if="{{post.isOwner}}" class="danger-link" disabled="{{operating}}" bindtap="remove">删除帖子</button>
    </view>
  </block>
  <view class="empty-panel" wx:else><text class="empty-title">{{loading ? '正在加载…' : error}}</text><button wx:if="{{!loading}}" class="text-link" bindtap="retry">重新加载</button></view>
  <template is="bottom-nav" data="{{active: ''}}"/>
</view>
