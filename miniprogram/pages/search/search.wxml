<view class="page search-page">
  <view class="search-head"><button class="search-back" bindtap="back">‹</button><view class="search-entry"><text class="search-icon">⌕</text><input focus="{{!searched}}" value="{{keyword}}" placeholder="搜物品、地点或关键词" confirm-type="search" bindinput="inputChange" bindconfirm="submit"/><text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</text></view></view>
  <view class="history-panel" wx:if="{{!searched && !keyword}}"><view class="history-head"><text>历史搜索</text><button class="history-trash" wx:if="{{history.length}}" bindtap="clearHistory">🗑️</button></view><view class="history-list" wx:if="{{history.length}}"><block wx:for="{{history}}" wx:key="*this"><button class="history-item" data-keyword="{{item}}" bindtap="useHistory">{{item}}</button></block></view><text class="history-empty" wx:else>暂无搜索记录</text></view>
  <view class="search-result-head" wx:if="{{searched}}"><text>搜索结果</text><text>{{posts.length}} 条</text></view>
  <view class="task-list search-results"><block wx:for="{{posts}}" wx:key="id"><view class="task" data-id="{{item.id}}" bindtap="openDetail"><view class="task-top"><text class="badge {{item.intent === 'offer' ? 'offer' : ''}}">{{item.intent === 'offer' ? '可提供' : '求帮助'}}</text><text class="task-category">{{item.category}}</text></view><text class="task-title">{{item.title || item.subcategory || item.category}}</text><text class="route">⌖ {{item.place || '校内交接'}}</text><view class="meta"><text>◷ {{item.time || '时间待定'}}</text><text>{{item.subcategory || item.category}}</text></view><button class="task-action {{item.actionDisabled ? 'disabled' : ''}}" disabled="{{item.actionDisabled || pendingClaimId !== null}}" loading="{{pendingClaimId === item.id}}" catchtap="claim" data-id="{{item.id}}">{{pendingClaimId === item.id ? '处理中' : item.actionButtonLabel}}</button></view></block><view class="empty" wx:if="{{searched && !loading && !posts.length}}">没有找到相关内容，换个关键词试试</view><view class="empty" wx:if="{{loading}}">正在搜索…</view></view>
</view>
