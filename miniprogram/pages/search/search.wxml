<import src="../../templates/board.wxml"/>
<view class="page search-page">
  <view class="search-head"><view class="search-entry"><text class="magnifier"></text><input focus="{{!searched}}" value="{{keyword}}" placeholder="搜索互助、地点或好物" confirm-type="search" bindinput="inputChange" bindconfirm="submit"/><button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch" aria-label="清空搜索">×</button></view><button class="search-submit" bindtap="submit">搜索</button></view>
  <view class="board-section" wx:if="{{!searched}}">
    <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">历史搜索</text></view><button class="section-more" wx:if="{{history.length}}" bindtap="clearHistory">清空</button></view>
    <view class="history-list"><block wx:for="{{history}}" wx:key="*this"><button class="history-item" data-keyword="{{item}}" bindtap="useHistory">{{item}}</button></block><text class="section-empty" wx:if="{{!history.length}}">暂无搜索记录</text></view>
  </view>
  <view class="board-section" wx:else>
    <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">{{title === '搜索' ? '搜索结果' : title}}</text></view><text class="section-total">{{posts.length}} 条</text></view>
    <view class="inline-error" wx:if="{{error}}" bindtap="retry">{{error}} ↻</view>
    <view class="board-list"><block wx:for="{{posts}}" wx:key="id"><template is="post-row" data="{{post: item}}"/></block></view>
    <view class="section-empty" wx:if="{{loading}}">正在查找…</view>
    <view class="section-empty" wx:if="{{!loading && !error && !posts.length}}">没有找到相关内容</view>
  </view>
  <template is="bottom-nav" data="{{active: ''}}"/>
</view>
