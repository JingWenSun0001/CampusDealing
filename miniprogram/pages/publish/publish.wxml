<import src="../../templates/board.wxml"/>
<view class="page publish-page">
  <view class="board-section category-panel">
    <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">发布类型</text></view></view>
    <view class="publish-categories"><block wx:for="{{categories}}" wx:key="category"><button class="publish-category {{selectedCategory === item.category ? 'active' : ''}}" data-category="{{item.category}}" bindtap="categorySelect"><image src="{{item.icon}}" mode="aspectFit"/><text>{{item.category}}</text></button></block></view>
  </view>
  <block wx:if="{{selectedCategory}}">
    <view class="board-section form-panel">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark bar"></text><text class="board-section-title">{{selectedCategory}}</text></view><text class="section-total">填写信息</text></view>
      <view class="form-item" wx:if="{{!flags.giveaway}}"><text class="label">{{meta.subLabel}}</text><floating-select id="select-subcategory" data-select="subcategory" label="{{meta.subLabel}}" options="{{subitems}}" value="{{selectedSubcategory}}" placeholder="请选择" bind:open="closeSelects" bind:change="selectValue"/></view>
      <view class="form-item" wx:if="{{flags.showIntent}}"><view class="radio-row"><button class="radio {{form.intent === 'seek' ? 'active' : ''}}" data-value="seek" bindtap="intentChange">{{meta.seekLabel}}</button><button class="radio {{form.intent === 'offer' ? 'active' : ''}}" data-value="offer" bindtap="intentChange">{{meta.offerLabel}}</button></view></view>
      <view class="form-item" wx:if="{{flags.showTitle}}"><text class="label">{{meta.titleLabel}}</text><input class="field" maxlength="60" placeholder="{{meta.titlePlaceholder}}" value="{{form.title}}" data-key="title" bindinput="inputChange"/></view>
      <block wx:if="{{flags.carpool}}">
        <view class="form-item"><text class="label">集合地点</text><floating-select id="select-place" data-select="place" label="集合地点" options="{{placeOptions}}" value="{{form.place}}" placeholder="选择集合地点" bind:open="closeSelects" bind:change="selectValue"/></view>
        <view class="row"><view class="form-item"><text class="label">出发日期</text><floating-select id="select-date" data-select="date" label="出发日期" mode="date" value="{{form.date}}" start="{{dateStart}}" placeholder="选择日期" bind:open="closeSelects" bind:change="selectValue"/></view><view class="form-item"><text class="label">出发时间</text><floating-select id="select-time" data-select="time" label="出发时间" mode="time" value="{{form.time}}" start="05:00" end="23:55" minute-step="{{5}}" placeholder="选择时间" bind:open="closeSelects" bind:change="selectValue"/></view></view>
        <text class="privacy-note">出发前 10 分钟自动结单，结单后仅可查看；人数够了也可提前手动结单。</text>
        <view class="form-item"><text class="label">所需搭子人数 <text class="optional" wx:if="{{editingId}}">发布后固定</text></text><floating-select id="select-people" data-select="people" label="所需搭子人数" options="{{peopleOptions}}" value="{{form.remainingPeople}}" disabled="{{!!editingId}}" bind:open="closeSelects" bind:change="selectValue"/></view>
        <view class="form-item"><text class="label">搭子性别</text><floating-select id="select-gender" data-select="gender" label="搭子性别" options="{{genderOptions}}" value="{{form.gender}}" bind:open="closeSelects" bind:change="selectValue"/></view>
        <view class="form-item qr-form-item"><text class="label">{{form.remainingPeople === '1' ? '微信加好友码' : '临时微信群二维码'}}</text><text class="privacy-note">仅加入成功的同学可见，用于后续行程沟通</text><view class="qr-upload"><image wx:if="{{qrPreview}}" class="qr-preview" src="{{qrPreview}}" mode="aspectFit"/><button wx:if="{{qrPreview}}" class="image-remove" bindtap="removeQr" aria-label="移除二维码">×</button><button wx:else class="image-add qr-add" bindtap="chooseQr"><text>＋</text><text>上传二维码</text></button></view></view>
      </block>
      <view class="form-item" wx:if="{{flags.showPlace}}"><text class="label">{{meta.placeLabel}}</text><input class="field" maxlength="60" placeholder="{{meta.placePlaceholder}}" value="{{form.place}}" data-key="place" bindinput="inputChange"/></view>
      <view class="form-item" wx:if="{{flags.showTime}}"><text class="label">{{meta.timeLabel}}</text><input class="field" maxlength="40" placeholder="例如：今天18:00前" value="{{form.time}}" data-key="time" bindinput="inputChange"/></view>
      <view class="form-item" wx:if="{{flags.giveaway}}"><text class="label">数量 <text class="optional">默认 1 份</text></text><input class="field" type="number" maxlength="4" value="{{form.quantity}}" data-key="quantity" bindinput="inputChange"/></view>
      <view class="form-item" wx:if="{{flags.goods}}"><text class="label">价格 <text class="optional">选填</text></text><view class="price-input"><text>¥</text><input maxlength="20" placeholder="填写价格" value="{{form.price}}" data-key="price" bindinput="inputChange"/></view></view>
      <view class="form-item" wx:if="{{flags.showDetail}}"><text class="label">{{selectedCategory === '代购' ? '数量、规格和备注' : '补充介绍'}} <text class="optional">选填</text></text><textarea class="field textarea" maxlength="500" placeholder="{{meta.detailPlaceholder}}" value="{{form.detail}}" data-key="detail" bindinput="inputChange"/></view>
      <view class="form-item" wx:if="{{flags.showImages}}"><text class="label">照片 <text class="optional">选填 · 最多9张</text></text><view class="image-grid"><block wx:for="{{images}}" wx:key="*this"><view class="image-preview"><image src="{{item}}" mode="aspectFill"/><button class="image-remove" data-index="{{index}}" bindtap="removeImage" aria-label="移除图片">×</button></view></block><button wx:if="{{images.length < 9}}" class="image-add" bindtap="chooseImages"><text>＋</text><text>添加照片</text></button></view></view>
    </view>
    <view class="board-section form-panel" wx:if="{{flags.showContact}}">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark clock"></text><text class="board-section-title">交接联系</text></view></view>
      <view class="form-item"><text class="label">联系方式</text><input class="field" maxlength="80" placeholder="微信 / QQ / 电话" value="{{form.contact}}" data-key="contact" bindinput="inputChange"/></view>
      <text class="privacy-note">仅发布者和已参与的同学可见</text>
    </view>
    <text class="error" wx:if="{{error}}">{{error}}</text>
    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在保存…' : (editingId ? '保存修改' : '发布信息')}}</button>
  </block>
  <view class="select-prompt" wx:else>选择一种类型，开始发布</view>
  <template is="bottom-nav" data="{{active: 'publish'}}"/>
</view>
