<view class="page publish-page">
  <view class="card publish-card">
    <view class="picker-wrap"><view class="picker-field" bindtap="openCategoryPicker"><text>{{selectedCategory || '想发布哪类信息？'}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover" wx:if="{{showCategoryPicker}}"><view class="picker-sheet-title">选一个发布类型吧</view><view class="picker-options"><block wx:for="{{categories}}" wx:key="*this"><button class="picker-option" data-category="{{item}}" bindtap="categorySelect">{{item}}</button></block></view></view></view>
    <block wx:if="{{selectedCategory}}">
    <view class="picker-wrap" wx:if="{{selectedCategory && !isFreeGive}}"><view class="picker-field" bindtap="openSubPicker"><text>{{selectedSubcategory || subcategoryPlaceholder}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover" wx:if="{{showSubPicker}}"><view class="picker-options"><block wx:for="{{subitems}}" wx:key="*this"><button class="picker-option" data-index="{{index}}" bindtap="subcategoryChange">{{item}}</button></block></view></view></view>
    <view class="form-item service-choice" wx:if="{{selectedCategory && !isFreeGive && selectedCategory !== '二手好物' && selectedCategory !== '拼车搭子' && selectedCategory !== '出租'}}"><view class="radio-row"><button class="radio {{form.intent === 'offer' ? 'active' : ''}}" data-value="offer" bindtap="intentChange">我可以帮忙</button><button class="radio {{form.intent === 'seek' ? 'active' : ''}}" data-value="seek" bindtap="intentChange">我需要帮助</button></view></view>
    <view class="form-item" wx:if="{{selectedCategory !== '拼车搭子' && selectedCategory !== '出租' && selectedCategory !== '代取' && !(selectedCategory === '代购' && form.intent === 'offer')}}"><text class="label">{{isFreeGive ? '你想送点什么' : meta.titleLabel}}</text><input class="field" maxlength="60" placeholder="{{isFreeGive ? '例如：台灯、衣物或教材' : (selectedCategory === '代购' && selectedSubcategory !== '小吃街' ? '' : meta.titlePlaceholder)}}" value="{{form.title}}" data-key="title" bindinput="inputChange"/></view>
    <view class="form-item image-upload-item" wx:if="{{(selectedCategory === '代取' && form.intent === 'seek') || selectedCategory === '二手好物'}}"><text class="label">商品图片</text><view class="image-grid"><block wx:for="{{images}}" wx:key="*this"><view class="image-preview"><image src="{{item}}" mode="aspectFill"/><button class="image-remove" data-index="{{index}}" bindtap="removeImage">×</button></view></block><button wx:if="{{images.length < 9}}" class="image-add" bindtap="chooseImages"><text class="image-add-icon">＋</text><text>添加图片</text></button></view></view>
    <view class="form-item" wx:if="{{selectedCategory === '出租'}}"><text class="label">补充介绍（可选）</text><textarea class="field textarea" maxlength="500" placeholder="例如：品牌、型号、使用情况等" value="{{form.detail}}" data-key="detail" bindinput="inputChange"></textarea></view>
    <view class="form-item image-upload-item" wx:if="{{selectedCategory === '出租'}}"><text class="label">添加照片（可选）</text><view class="image-grid"><block wx:for="{{images}}" wx:key="*this"><view class="image-preview"><image src="{{item}}" mode="aspectFill"/><button class="image-remove" data-index="{{index}}" bindtap="removeImage">×</button></view></block><button wx:if="{{images.length < 9}}" class="image-add" bindtap="chooseImages"><text class="image-add-icon">＋</text><text>添加图片</text></button></view></view>
    <view class="form-item" wx:if="{{selectedCategory === '拼车搭子'}}"><view class="picker-wrap"><view class="picker-field" bindtap="openPlacePicker"><text>{{form.place || meta.placePlaceholder}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover" wx:if="{{showPlacePicker}}"><view class="picker-options"><block wx:for="{{placeOptions}}" wx:key="*this"><button class="picker-option" data-index="{{index}}" bindtap="placeSelect">{{item}}</button></block></view></view></view></view>
    <view class="form-item" wx:if="{{selectedCategory !== '拼车搭子' && selectedCategory !== '出租' && selectedCategory !== '代取' && selectedCategory !== '二手好物' && !(selectedCategory === '代购' && (form.intent === 'seek' || form.intent === 'offer'))}}"><text class="label">{{meta.placeLabel}}</text><input class="field" maxlength="60" placeholder="{{meta.placePlaceholder}}" value="{{form.place}}" data-key="place" bindinput="inputChange"/></view>
    <view class="form-item" wx:if="{{isFreeGive}}"><text class="label">数量（可选）</text><view class="picker-wrap"><view class="picker-field" bindtap="openQuantityPicker"><text>{{form.quantity}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover quantity-picker-popover" wx:if="{{showQuantityPicker}}"><view class="picker-options quantity-picker-options"><block wx:for="{{quantityOptions}}" wx:key="*this"><button class="picker-option" data-index="{{index}}" bindtap="quantitySelect">{{item}}</button></block></view></view></view></view>
    <view class="form-item" wx:if="{{selectedCategory === '拼车搭子'}}"><view class="picker-wrap"><view class="picker-field" bindtap="openPeoplePicker"><text>{{form.remainingPeople || '还需几人'}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover" wx:if="{{showPeoplePicker}}"><view class="picker-options quantity-picker-options"><block wx:for="{{peopleOptions}}" wx:key="*this"><button class="picker-option" data-index="{{index}}" bindtap="peopleSelect">{{item}}</button></block></view></view></view></view>
    <view class="row carpool-meta-row" wx:if="{{selectedCategory === '拼车搭子' && !isFreeGive}}"><view class="form-item"><view class="picker-wrap"><view class="picker-field" bindtap="openTimePicker"><text>{{form.time || '选一个出发时间吧'}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover time-picker-popover" wx:if="{{showTimePicker}}"><view wx:if="{{timeStage === 'hour'}}" class="time-picker-single-column"><scroll-view class="time-picker-column" scroll-y="true"><block wx:for="{{timeHours}}" wx:key="*this"><button class="time-option" data-value="{{item}}" bindtap="timeHourSelect">{{item}}点</button></block></scroll-view></view><view wx:else class="time-picker-single-column"><button class="time-back" bindtap="timeBackToHour">‹ 重新选小时（{{timeDraftHour}}点）</button><scroll-view class="time-picker-column" scroll-y="true"><block wx:for="{{timeMinutes}}" wx:key="*this"><button class="time-option" data-value="{{item}}" bindtap="timeMinuteSelect">{{item}}分</button></block></scroll-view></view></view></view></view><view class="form-item"><view class="picker-wrap"><view class="picker-field" bindtap="openGenderPicker"><text>{{form.gender || '对搭子性别有要求吗'}}</text><text class="picker-arrow">⌄</text></view><view class="picker-popover gender-picker-popover" wx:if="{{showGenderPicker}}"><view class="picker-options gender-picker-options"><block wx:for="{{genderOptions}}" wx:key="*this"><button class="picker-option" data-value="{{item}}" bindtap="genderSelect">{{item}}</button></block></view></view></view></view></view>
    <view class="form-item" wx:if="{{selectedCategory !== '拼车搭子' && selectedCategory !== '出租' && selectedCategory !== '代取' && selectedCategory !== '二手好物' && !isFreeGive && !(selectedCategory === '代购' && (form.intent === 'seek' || form.intent === 'offer'))}}"><text class="label">{{meta.timeLabel}}</text><input class="field" maxlength="40" placeholder="{{meta.timePlaceholder}}" value="{{form.time}}" data-key="time" bindinput="inputChange"/></view>
    <view class="form-item secondhand-price" wx:if="{{selectedCategory === '二手好物'}}"><text class="label">价格</text><input class="field" maxlength="20" placeholder="例如：20" value="{{form.price}}" data-key="price" bindinput="inputChange"/><text class="price-tip">小额出让，容易更快卖出哦</text></view>
    <view class="form-item" wx:if="{{selectedCategory === '代购' && form.intent === 'seek'}}"><text class="label">数量、规格和备注</text><textarea class="field textarea" maxlength="500" placeholder="{{selectedSubcategory !== '小吃街' ? '' : '例如：4杯、少冰、去冰等'}}" value="{{form.detail}}" data-key="detail" bindinput="inputChange"></textarea></view>
    <view class="form-item" wx:if="{{selectedCategory !== '拼车搭子' && selectedCategory !== '出租' && selectedCategory !== '代取' && selectedCategory !== '代购' && selectedCategory !== '二手好物' && !isFreeGive}}"><text class="label">补充说明（可选）</text><textarea class="field textarea" maxlength="500" placeholder="{{meta.detailPlaceholder}}" value="{{form.detail}}" data-key="detail" bindinput="inputChange"></textarea></view>
    <view class="form-item" wx:if="{{selectedCategory !== '拼车搭子' && selectedCategory !== '出租' && selectedCategory !== '代取' && selectedCategory !== '二手好物' && !isFreeGive && !(selectedCategory === '代购' && (form.intent === 'seek' || form.intent === 'offer'))}}"><text class="label">联系方式</text><input class="field" maxlength="80" placeholder="微信 / QQ / 电话，参与后可见" value="{{form.contact}}" data-key="contact" bindinput="inputChange"/></view>
    <text class="privacy-note" wx:if="{{selectedCategory !== '拼车搭子' && selectedCategory !== '出租' && selectedCategory !== '代取' && selectedCategory !== '二手好物' && !isFreeGive && !(selectedCategory === '代购' && (form.intent === 'seek' || form.intent === 'offer'))}}">联系方式只会展示给发布者和已参与的同学</text><text class="error">{{error}}</text><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在发布…' : '发布信息'}}</button>
    </block>
  </view>
  <view class="picker-mask" wx:if="{{showCategoryPicker || showSubPicker || showPlacePicker || showDeliveryPicker || showQuantityPicker || showPeoplePicker || showTimePicker || showGenderPicker}}" bindtap="closePickers"></view>
  <view class="nav"><navigator class="nav-item" url="/pages/index/index" open-type="reLaunch"><text class="nav-icon nav-home"></text><text>首页</text></navigator><navigator class="nav-add active" url="/pages/publish/publish">＋</navigator><navigator class="nav-item" url="/pages/profile/profile"><text class="nav-icon nav-profile"></text><text>我的</text></navigator></view>
</view>
