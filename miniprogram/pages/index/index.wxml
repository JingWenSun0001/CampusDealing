<import src="../../templates/board.wxml"/>
<view class="page home-page">
  <button class="feed-tools search-shortcut" bindtap="openSearch" aria-label="打开搜索"><text class="magnifier"></text><text>搜索</text></button>
  <view class="service-rail">
    <block wx:for="{{quickDefs}}" wx:key="category"><button class="rail-item {{selectedCategory === item.category ? 'active' : ''}}" data-category="{{item.category}}" bindtap="openCategory"><view class="rail-icon {{item.key}}"><image wx:if="{{item.key !== 'service'}}" src="{{item.icon}}" mode="aspectFit"/><view wx:else class="sparkles-icon"><text class="sparkle sparkle-large">✦</text><text class="sparkle sparkle-small">✦</text></view></view><text class="rail-name">{{item.category}}</text><view class="rail-indicator"></view></button></block>
  </view>
  <scroll-view class="sub-scroll" scroll-x wx:if="{{subitems.length}}"><button class="sub-pill {{!selectedSub ? 'active' : ''}}" data-sub="" bindtap="selectSub">全部</button><block wx:for="{{subitems}}" wx:key="*this"><button class="sub-pill {{selectedSub === item ? 'active' : ''}}" data-sub="{{item}}" bindtap="selectSub">{{item}}</button></block></scroll-view>
  <view class="inline-error" wx:if="{{error}}" bindtap="retry">{{error}} ↻</view>
  <block wx:if="{{selectedCategory}}"><view class="board-section category-feed" wx:if="{{posts.length}}"><view class="board-list"><block wx:for="{{posts}}" wx:key="id"><template is="post-row" data="{{post: item}}"/></block></view></view></block>
  <block wx:else><block wx:for="{{sections}}" wx:key="key" wx:for-item="section">
      <view class="board-section home-section section-{{section.key}} {{section.tone}}">
        <view class="board-section-head"><view class="section-heading"><text class="section-mark {{section.mark}}"></text><text class="board-section-title">{{section.title}}</text></view><button class="section-more" data-scope="{{section.key}}" bindtap="openSection">更多<text>›</text></button></view>
        <view wx:if="{{section.key === 'upcoming'}}" class="trip-list"><block wx:for="{{section.posts}}" wx:key="id"><view class="trip-card" data-id="{{item.id}}" bindtap="openDetail" bindlongpress="report"><view class="trip-icon"><image src="{{item.categoryIcon}}" mode="aspectFit"/></view><view class="trip-main"><view class="trip-top"><text class="trip-time">{{item.timeLabel || '待定'}}</text><text class="board-state {{item.stateTone}}">{{item.stateLabel}}</text></view><view class="trip-route"><text>{{item.placeLabel || '集合地点待定'}}</text><text class="trip-route-arrow">→</text><text>{{item.displaySubcategory || item.subcategory}}</text></view></view><view class="trip-side"><text>{{item.countText}}</text></view></view></block></view>
        <view wx:elif="{{section.key === 'now'}}" class="help-grid"><block wx:for="{{section.posts}}" wx:key="id"><view class="help-card" data-id="{{item.id}}" bindtap="openDetail" bindlongpress="report"><view class="help-cover"><image wx:if="{{item.cover}}" class="card-photo" src="{{item.cover}}" mode="aspectFill"/><view wx:elif="{{item.categoryKey === 'service'}}" class="sparkles-icon help-sparkles"><text class="sparkle sparkle-large">✦</text><text class="sparkle sparkle-small">✦</text></view><image wx:else src="{{item.categoryIcon}}" mode="aspectFit"/></view><text class="help-title">{{item.title || item.subcategory}}</text><view class="help-meta"><text class="board-tag">{{item.category}}</text><text class="board-state {{item.stateTone}}">{{item.stateLabel}}</text></view></view></block></view>
        <view wx:else class="goods-grid"><block wx:for="{{section.posts}}" wx:key="id"><view class="goods-card" data-id="{{item.id}}" bindtap="openDetail" bindlongpress="report"><view class="goods-cover"><image wx:if="{{item.cover}}" class="card-photo" src="{{item.cover}}" mode="aspectFill"/><image wx:else src="{{item.categoryIcon}}" mode="aspectFit"/></view><view class="goods-copy"><text class="goods-title">{{item.title || item.subcategory}}</text><view class="goods-meta"><view><text class="board-tag warm">{{item.category}}</text><text class="board-state {{item.stateTone}}">{{item.stateLabel}}</text></view><text class="row-price {{item.isFreeGive ? 'free' : ''}}">{{item.priceLabel}}</text></view></view></view></block></view>
      </view>
    </block>
  </block>
  <view wx:if="{{loading && !posts.length}}" class="board-section skeleton-panel"><view class="skeleton-heading"></view><view class="skeleton-row"></view><view class="skeleton-row"></view><view class="skeleton-row"></view></view>
  <view class="empty-panel" wx:if="{{!loading && !error && !posts.length}}"><button class="empty-symbol" bindtap="openPublish" aria-label="发布互助">＋</button><text class="empty-title">暂时没有相关互助</text><button class="text-link" bindtap="openPublish">发布一条互助 ›</button></view>
  <template is="bottom-nav" data="{{active: 'home'}}"/>
</view>
