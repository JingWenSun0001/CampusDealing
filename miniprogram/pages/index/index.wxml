<view class="page home-page">
  <view class="search-bar" bindtap="openSearch"><text class="search-icon">⌕</text><text class="search-placeholder">搜物品、地点或关键词</text></view>
  <view class="category-panel"><view class="quick-grid"><block wx:for="{{quickDefs}}" wx:key="category"><button class="quick {{selectedCategory === item.category ? 'active' : ''}}" data-category="{{item.category}}" bindtap="openCategory"><text class="quick-icon icon-{{index}}">{{item.icon}}</text><text class="quick-name">{{item.category}}</text></button></block></view></view>
  <scroll-view class="sub-scroll" scroll-x enable-flex wx:if="{{selectedCategory}}"><button class="sub-pill {{!selectedSub ? 'active' : ''}}" data-sub="" bindtap="selectSub">全部</button><block wx:for="{{subitems}}" wx:key="*this"><button class="sub-pill {{selectedSub === item ? 'active' : ''}}" data-sub="{{item}}" bindtap="selectSub">{{item}}</button></block></scroll-view>
  <view class="task-list"><block wx:for="{{posts}}" wx:key="id"><view class="task" data-id="{{item.id}}" bindtap="openDetail"><view class="task-top"><text class="badge {{item.intent === 'offer' ? 'offer' : ''}}">{{item.intent === 'offer' ? '可提供' : '求帮助'}}</text><text class="task-category">{{item.category}}</text><text class="price" wx:if="{{item.price && item.category !== '拼车搭子' && item.category !== '拼车' && item.category !== '免费送'}}">{{item.price}}</text></view><text class="task-title">{{item.title || item.subcategory || item.category}}</text><text class="route" wx:if="{{item.category !== '免费送'}}">⌖ {{item.place || '校内交接'}}</text><view class="meta" wx:if="{{item.category !== '免费送'}}"><text>◷ {{item.time || '时间待定'}}</text><text>{{item.subcategory || item.category}}</text></view><button wx:if="{{item.category === '免费送' || item.category !== '免费送'}}" class="task-action {{item.category === '免费送' ? 'free-give-action' : ''}} {{item.actionDisabled ? 'disabled' : ''}}" disabled="{{item.actionDisabled || pendingClaimId !== null}}" loading="{{pendingClaimId === item.id}}" catchtap="claim" data-id="{{item.id}}">{{pendingClaimId === item.id ? '处理中' : item.actionButtonLabel}}</button></view></block><view class="empty" wx:if="{{!loading && !posts.length}}">暂时没有匹配的单，换个关键词试试</view><view class="empty" wx:if="{{loading}}">正在加载…</view></view>
  <view class="nav"><navigator class="nav-item active" url="/pages/index/index" open-type="reLaunch"><text class="nav-icon nav-home"></text><text>首页</text></navigator><navigator class="nav-add" url="/pages/publish/publish">＋</navigator><navigator class="nav-item" url="/pages/profile/profile"><text class="nav-icon nav-profile"></text><text>我的</text></navigator></view>
</view>
