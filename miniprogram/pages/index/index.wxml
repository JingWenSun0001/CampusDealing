<import src="../../templates/board.wxml"/>
<view class="page home-page">
  <view class="service-rail">
    <block wx:for="{{quickDefs}}" wx:key="category"><button class="rail-item {{selectedCategory === item.category ? 'active' : ''}}" data-category="{{item.category}}" bindtap="openCategory"><view class="rail-icon"><image src="{{item.icon}}" mode="aspectFit"/></view><text class="rail-name">{{item.category}}</text><view class="rail-indicator"></view></button></block>
  </view>
  <view class="feed-tools"><text>{{selectedCategory || '全部动态'}}</text><button class="search-shortcut" bindtap="openSearch"><text class="magnifier"></text><text>搜索</text></button></view>
  <scroll-view class="sub-scroll" scroll-x wx:if="{{subitems.length}}"><button class="sub-pill {{!selectedSub ? 'active' : ''}}" data-sub="" bindtap="selectSub">全部</button><block wx:for="{{subitems}}" wx:key="*this"><button class="sub-pill {{selectedSub === item ? 'active' : ''}}" data-sub="{{item}}" bindtap="selectSub">{{item}}</button></block></scroll-view>
  <view class="inline-error" wx:if="{{error}}" bindtap="retry">{{error}} ↻</view>
  <block wx:for="{{sections}}" wx:key="key" wx:for-item="section">
    <view class="board-section {{section.tone}}">
      <view class="board-section-head"><view class="section-heading"><text class="section-mark {{section.mark}}"></text><text class="board-section-title">{{section.title}}</text></view><button class="section-more" data-scope="{{section.key}}" bindtap="openSection">更多<text> ›</text></button></view>
      <view class="board-list"><block wx:for="{{section.posts}}" wx:key="id"><template is="post-row" data="{{post: item}}"/></block></view>
    </view>
  </block>
  <view wx:if="{{loading && !posts.length}}" class="board-section skeleton-panel"><view class="skeleton-heading"></view><view class="skeleton-row"></view><view class="skeleton-row"></view><view class="skeleton-row"></view></view>
  <view class="empty-panel" wx:if="{{!loading && !error && !posts.length}}"><text class="empty-symbol">＋</text><text class="empty-title">暂时没有相关互助</text><navigator class="text-link" url="/pages/publish/publish">发布一条互助 ›</navigator></view>
  <template is="bottom-nav" data="{{active: 'home'}}"/>
</view>
