.avatar-page {
  min-height: 100vh;
  padding: 42rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #111;
}

.avatar-full {
  width: 100%;
  height: 860rpx;
  border-radius: 28rpx;
  background: #202020;
}

.avatar-change {
  display: flex;
  width: 250rpx;
  height: 78rpx;
  margin: 30rpx auto 0;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #ffffff;
  color: #111111;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}
