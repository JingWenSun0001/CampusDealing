:host { display:block;min-width:0; }
view,text,button,scroll-view { box-sizing:border-box; }
button { min-height:0;margin:0;padding:0;border:0;border-radius:0;background:transparent;font:inherit;line-height:inherit; }
button::after { border:0; }
.fs-trigger { display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-width:0;height:82rpx;padding:0 22rpx;border:1rpx solid #e7ecf3;border-radius:18rpx;background:#f8f9fb;color:#25374e;font-size:26rpx;line-height:1.4;transition:border-color .15s,background .15s; }
.fs-trigger.is-open { border-color:#bad5f7;background:#f4f8fe; }
.fs-trigger.is-disabled { opacity:.55; }
.fs-value { flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.fs-value.is-placeholder { color:#95a2b5; }
.fs-chevron { flex:0 0 auto;width:10rpx;height:10rpx;margin:0 3rpx 5rpx;border-right:2rpx solid #9aa8bc;border-bottom:2rpx solid #9aa8bc;transform:rotate(45deg);transition:transform .16s; }
.is-open .fs-chevron { margin-top:7rpx;transform:rotate(225deg);border-color:#307fe6; }
.fs-backdrop { position:fixed;z-index:2100;top:0;right:0;bottom:0;left:0;background:rgba(28,42,61,.025); }
.fs-panel { position:fixed;z-index:2101;overflow-y:auto;padding:10rpx;border:1rpx solid rgba(255,255,255,.94);border-radius:32rpx;background:rgba(250,251,253,.97);box-shadow:0 18rpx 70rpx rgba(25,40,62,.16),0 2rpx 12rpx rgba(25,40,62,.05);-webkit-backdrop-filter:blur(28px);backdrop-filter:blur(28px);transform-origin:50% 0;animation:fs-appear .16s ease-out; }
.fs-panel.opens-up { transform-origin:50% 100%; }
.fs-option-list,.fs-content-scroll { display:block;width:100%; }
.fs-layout { display:flex;flex-direction:column;min-height:0; }
.fs-layout>.fs-content-scroll { flex:0 0 auto;min-height:0; }
.fs-option { display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:88rpx;padding:18rpx 22rpx;border-radius:21rpx;color:#26364c;font-size:27rpx;line-height:1.45; }
.fs-option + .fs-option { border-top:1rpx solid rgba(151,165,185,.13); }
.fs-option:active { background:#eaf1fb; }
.fs-option.is-selected { background:#e8f1ff;color:#2478df; }
.fs-option-copy { display:flex;align-items:center;gap:12rpx;min-width:0; }
.fs-option-text { min-width:0;word-break:break-all; }
.fs-option-hint { color:#96a2b3;font-size:20rpx;white-space:nowrap; }
.fs-option.is-selected .fs-option-hint { color:#72a6e8; }
.fs-no-options { padding:25rpx;text-align:center;color:#9aa6b5;font-size:24rpx; }
.fs-calendar,.fs-time { padding:7rpx 12rpx 0; }
.fs-calendar-head { display:flex;align-items:center;justify-content:space-between;height:72rpx; }
.fs-month-arrow { display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;color:#2a7de1;font-size:48rpx;font-weight:300;line-height:1; }
.fs-month-title { color:#27384d;font-size:28rpx;font-weight:600; }
.fs-weekdays { display:flex;align-items:center;height:50rpx;color:#9aa5b3;font-size:21rpx;text-align:center; }
.fs-weekdays text { width:14.285714%; }
.fs-days { display:flex;flex-wrap:wrap; }
.fs-day { display:flex;align-items:center;justify-content:center;width:14.285714%;height:68rpx;color:#30415a;font-size:25rpx; }
.fs-day text { display:flex;align-items:center;justify-content:center;width:57rpx;height:57rpx;border-radius:50%; }
.fs-day.is-today text { color:#287de5;font-weight:600; }
.fs-day.is-selected text { background:#287de5;color:#fff;box-shadow:0 4rpx 12rpx #287de52b; }
.fs-day.is-unavailable { color:#c9d0da; }
.fs-day.is-unavailable.is-today text { color:#c9d0da; }
.fs-month-arrow.is-unavailable { color:#ced6e1; }
.fs-footer { display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:13rpx;padding:13rpx 0 8rpx;border-top:1rpx solid #e4e9f0; }
.fs-footer.fs-fixed-footer { flex:0 0 92rpx;min-height:92rpx;margin-top:0;padding-right:12rpx;padding-left:12rpx; }
.fs-footer button { display:flex;align-items:center;justify-content:center;flex:1;height:64rpx;border-radius:18rpx;font-size:25rpx; }
.fs-cancel { color:#8593a7; }
.fs-confirm { background:#e8f1ff;color:#287ade;font-weight:600; }
.fs-confirm:active { background:#dbeafe; }
.fs-time-head { display:flex;align-items:center;justify-content:space-between;gap:14rpx;height:67rpx;color:#35465b;font-size:25rpx;font-weight:600; }
.fs-time-summary { color:#287de5;font-size:30rpx;font-variant-numeric:tabular-nums; }
.fs-time-labels { display:flex;gap:17rpx;padding-bottom:12rpx;color:#97a4b6;font-size:22rpx;text-align:center; }
.fs-time-labels text { flex:1; }
.fs-time-columns { display:flex;gap:17rpx; }
.fs-time-column { display:block;flex:1;width:0;height:320rpx;border-radius:20rpx;background:rgba(239,243,249,.7); }
.fs-time-option { display:flex;align-items:center;justify-content:center;gap:12rpx;height:72rpx;margin:5rpx 6rpx;border-radius:15rpx;color:#3b4c64;font-size:29rpx;font-variant-numeric:tabular-nums; }
.fs-time-option.is-selected { background:#e0edff;color:#2479df;font-weight:600; }
@keyframes fs-appear { from { opacity:0;transform:translateY(-4rpx) scale(.97); } to { opacity:1;transform:translateY(0) scale(1); } }
